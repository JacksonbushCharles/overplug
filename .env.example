# Resend SMTP credentials. Keep the real values in .env.local (never commit it).
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=re_replace_with_your_resend_smtp_key

# Use a sender domain verified in Resend.
SMTP_FROM_NAME=EchoMail
SMTP_FROM_EMAIL=notifications@your-verified-domain.com
SMTP_REPLY_TO=support@your-verified-domain.com
